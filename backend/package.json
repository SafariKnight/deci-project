{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "src/vercel.ts",
  "imports": {
    "#src/*": "./src/*",
    "#prisma/*": "./prisma/generated/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.dev tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "test": "NODE_ENV=test dotenv -e ../.env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --no-coverage",
    "prestart": "tsc",
    "start": "node dist/src/server.js",
    "postinstall": "prisma generate",
    "prisma:seed": "dotenv -e .env.dev prisma db seed",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "vercel": "vercel"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.3",
    "mongodb": "^7.5.0",
    "multer": "^2.0.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vercel": "^58.11.0"
  }
}
